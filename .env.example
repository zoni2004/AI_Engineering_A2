# Copy to .env (never commit .env). Create your own key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
STUDENT_NAME=Your Name
ROLL_NO=Your Roll Number
# Verify these IDs on openrouter.ai before running
MODEL_JEV=typesafe/jev-1.13
MODEL_LUNA=openai/gpt-6-luna-decisions
MODEL_CLEF=cloudflare/clef
MODEL_OPUS=anthropic/claude-opus-5.5
MAX_MOVES=30
TIME_LIMIT_S=300
REQUEST_TIMEOUT_S=60
MAX_RETRIES=1
RECENT_N=6
# 1 = simulated players, offline UI test only (not real model results)
MOCK_MODE=0
